<Project Sdk="Microsoft.NET.Sdk">
  <!-- Round-trip check for src\ForeverCapture: the sandbox server's own writers (login replies, world framing and encryption,
       game object create blocks) produce a session, and the capture code must read the same objects back out of it.
       Run: dotnet artifacts\bin\ForeverCapture.Tests\release\ForeverCapture.Tests.dll -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ForeverCapture/Decode.cs" Link="Capture/Decode.cs" />
    <Compile Include="../../src/ForeverCapture/NetCapture.cs" Link="Capture/NetCapture.cs" />
    <Compile Include="../../src/ForeverCapture/LoginRelay.cs" Link="Capture/LoginRelay.cs" />
    <Compile Include="../../src/ForeverCapture/LiveCapture.cs" Link="Capture/LiveCapture.cs" />
    <Compile Include="../../src/ForeverCapture/LocalMap.cs" Link="Capture/LocalMap.cs" />
    <!-- The same server sources tests\ForeverSandbox.Tests compiles in. -->
    <Compile Include="../../src/ForeverSandbox.Server/WorldServer/Network/ForeverWorldWire.cs" Link="Server/ForeverWorldWire.cs" />
    <Compile Include="../../src/ForeverSandbox.Server/WorldServer/Network/ForeverWorldCrypto.cs" Link="Server/ForeverWorldCrypto.cs" />
    <Compile Include="../../src/ForeverSandbox.Server/WorldServer/Network/ForeverWorldPackets.cs" Link="Server/ForeverWorldPackets.cs" />
