    <Compile Include="../../src/ForeverSandbox.Server/WorldServer/Network/ForeverSpells.cs" Link="Server/ForeverSpells.cs" />
    <Compile Include="../../src/ForeverSandbox.Server/WorldServer/Network/ForeverUpdateFields.g.cs" Link="Server/ForeverUpdateFields.g.cs" />
    <Compile Include="../../src/ForeverSandbox.Server/LocalAuthDiagnostics.cs" Link="Server/LocalAuthDiagnostics.cs" />
