<Project Sdk="Microsoft.NET.Sdk">
  <!-- Forever Sandbox launcher: starts the sandbox server and the frozen 70338 client, keeps the local login certificates valid,
       and (opt-in) applies the realm-key write the world connection needs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ForeverSandbox</AssemblyName>
  </PropertyGroup>
</Project>
